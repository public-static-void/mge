{
  "title": "Scenarios",
  "description": "Master registry of event-driven narrative scenario definitions (incident director).",
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "turn_gte",
                    "entity_count_gte",
                    "faction_standing_lte",
                    "faction_standing_gte",
                    "faction_relation_is",
                    "scenario_resolved",
                    "chance"
                  ]
                },
                "turn": { "type": "integer" },
                "component": { "type": "string" },
                "count": { "type": "integer" },
                "a": { "type": "string" },
                "b": { "type": "string" },
                "value": { "type": "integer" },
                "relation": {
                  "type": "string",
                  "enum": ["allied", "neutral", "hostile", "war"]
                },
                "scenario_id": { "type": "string" },
                "p": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["type"]
            },
            "default": []
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action": { "type": "string" },
                      "data": { "type": "object" }
                    },
                    "required": ["action"]
                  },
                  "default": []
                }
              },
              "required": ["id", "label"]
            }
          },
          "cooldown_turns": { "type": "integer", "default": 0 },
          "expires_in_turns": { "type": "integer" },
          "once": { "type": "boolean", "default": false },
          "weight": { "type": "number", "default": 1.0 }
        },
        "required": ["id", "name", "choices"]
      }
    }
  },
  "required": ["scenarios"],
  "scenarios": []
}
