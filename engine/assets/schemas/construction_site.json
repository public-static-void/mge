{
  "title": "ConstructionSite",
  "type": "object",
  "properties": {
    "building_type": { "type": "string" },
    "target_position": {
      "type": "object",
      "properties": {
        "pos": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "Square": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "integer" },
                    "y": { "type": "integer" },
                    "z": { "type": "integer" }
                  },
                  "required": ["x", "y", "z"]
                }
              },
              "required": ["Square"]
            },
            {
              "type": "object",
              "properties": {
                "Hex": {
                  "type": "object",
                  "properties": {
                    "q": { "type": "integer" },
                    "r": { "type": "integer" },
                    "z": { "type": "integer" }
                  },
                  "required": ["q", "r", "z"]
                }
              },
              "required": ["Hex"]
            },
            {
              "type": "object",
              "properties": {
                "Province": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" }
                  },
                  "required": ["id"]
                }
              },
              "required": ["Province"]
            }
          ]
        }
      }
    },
    "required_materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "amount": { "type": "integer", "minimum": 1 }
        },
        "required": ["kind", "amount"]
      }
    },
    "progress": { "type": "integer", "minimum": 0, "default": 0 },
    "required_work": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["pending", "reserved", "delivering", "in_progress", "complete", "cancelled"],
      "default": "pending"
    },
    "reserved_stockpile": { "type": ["integer", "null"], "default": null },
    "assigned_job": { "type": ["integer", "null"], "default": null }
  },
  "required": ["building_type", "target_position", "required_materials", "progress", "required_work", "state"],
  "modes": ["colony"]
}
