{
  "title": "CraftOrder",
  "type": "object",
  "description": "Tracks an in-progress crafting job on a crafter entity. Consumed by CraftingSystem.",
  "properties": {
    "recipe": { "type": "string" },
    "progress": { "type": "integer", "minimum": 0, "default": 0 },
    "state": {
      "type": "string",
      "enum": ["in_progress", "complete", "cancelled"],
      "default": "in_progress"
    },
    "output_entity": { "type": ["integer", "null"], "default": null }
  },
  "required": ["recipe", "progress", "state"],
  "modes": ["colony", "roguelike"]
}
