# System/Editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Python
*.pyc
*.pyo
*.pyd
*.pdb
__pycache__/
*.egg-info/
.eggs/
*.egg
.env
.venv/
venv/
ENV/
env/
pip-wheel-metadata/

# Node
node_modules/

# Build artifacts
build/
dist/
target/

# Compiled/binary artifacts
*.o
*.obj
*.so
*.dll
*.dylib
*.exe
*.out
*.class
*.whl

# Rust backup files
**/*.rs.bk

# Logs and temp files
*.log
*.tmp
*.bak
# Scratch verification files (e.g. tmp_* bridge checks)
**/tmp_*
# ...except the Lua save-test path helper, which is a committed source file
!engine/scripts/lua/tests/helpers/tmp_path.lua

# IDE/Project settings
.vscode/
.idea/
.ropeproject/
.spyderproject
.spyproject

# Project-specific
test_save.json
test_vehicle_save.json
test_crafting_save.json
roguelike_save.json
test_job_event_log.json
test_event_log.json
mge_demo_save_*.json
knowledge/

# Plugins: ignore build artifacts in all subfolders
plugins/*/*.so
plugins/*/*.dll
plugins/*/*.dylib
plugins/*/*.o
plugins/*/*.obj

# Ignore CMake and build system artifacts in plugins
plugins/**/build/
plugins/**/CMakeFiles/
plugins/**/cmake-build-*/
plugins/**/Makefile
plugins/**/CMakeCache.txt

# Ignore extensionless files in plugin roots (likely binaries)
plugins/*/[^./]*

# Whitelist source and config files in plugins
!plugins/**/*.rs
!plugins/**/*.c
!plugins/**/*.cpp
!plugins/**/*.h
!plugins/**/*.hpp
!plugins/**/*.json
!plugins/**/*.toml
!plugins/**/*.md
!plugins/**/*.txt
!plugins/**/Cargo.toml
!plugins/**/plugin.json
!plugins/**/src/

# Ignore all WASM files in test/build directories
engine_wasm/wasm_tests/*.wasm
engine_wasm/tests/*.wasm
